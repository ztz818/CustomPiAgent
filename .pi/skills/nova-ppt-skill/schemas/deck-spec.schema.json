{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nova PPT Deck Specification",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "audience": {"type": "string"},
        "core_message": {"type": "string"},
        "language": {"type": "string", "default": "zh-CN"}
      },
      "additionalProperties": true
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {"type": "string", "default": "960pt"},
        "height": {"type": "string", "default": "540pt"}
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "message", "elements"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "role": {"type": "string"},
          "message": {"type": "string"},
          "background": {"type": "string"},
          "transition": {"type": "string"},
          "advanceTime": {"type": ["integer", "string"]},
          "advanceClick": {"type": ["boolean", "string"]},
          "hidden": {"type": ["boolean", "string"]},
          "notes": {"type": "string"},
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "props"],
              "properties": {
                "type": {
                  "enum": ["shape", "textbox", "picture", "table", "chart", "connector", "group", "notes", "icon"]
                },
                "icon": {"type": "string"},
                "color": {"type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$"},
                "props": {"type": "object"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
